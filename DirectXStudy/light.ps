
Texture2D diffuseTexture : register(t0);
SamplerState diffuseSampleType : register(s0);

cbuffer LightBuffer
{
	float4 diffuseColor;
	float3 lightDirection;
	float specularPower;
	float4 SpecularColor;
};


struct PixelInput 
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
	float3 normal : NORMAL;
	float3 viewDirection : TEXCOORD1;
};

float4 PS(PixelInput input):SV_TARGET
{	
	float4 textureColor;
	float3 lightDir;
	float lightIntensity;
	float4 finalColor;
	float4 color;
	float4 ambientColor = float4(0.15, 0.15, 0.15, 1.0);
	
	float3 reflection;
	float4 specular= float4(0.0, 0.0, 0.0, 0.0);


	textureColor = diffuseTexture.Sample(diffuseSampleType,input.uv);

	lightDir = normalize(-lightDirection);

	lightIntensity = saturate(dot(input.normal, lightDir));

	color = diffuseColor * lightIntensity;

	finalColor = saturate(color+ambientColor) * textureColor;

	reflection = normalize(2.0f * lightIntensity * input.normal - lightDir);

	specular = pow(saturate(dot(reflection, input.viewDirection)), specularPower);

	finalColor = saturate(finalColor + specular * SpecularColor);

	return finalColor;
}