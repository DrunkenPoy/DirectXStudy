
Texture2D diffuseTexture : register(t0);
SamplerState diffuseSampleType : register(s0);

/////////////
// DEFINES //
/////////////
#define NUM_LIGHTS 4

cbuffer LightBuffer
{
	float4 diffuseColor[NUM_LIGHTS];
	float3 lightDirection;
	float specularPower;
	float4 SpecularColor;
};

cbuffer LightPositionBuffer
{
	float4 lightPosition[NUM_LIGHTS];
};

struct PixelInput 
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
	float3 normal : NORMAL;
	float3 viewDirection : TEXCOORD1;
	float3 lightPos[NUM_LIGHTS] : TEXCOORD2;
};

float4 PS(PixelInput input):SV_TARGET
{	
	float4 textureColor;
	float3 lightDir;
	float lightIntensity[NUM_LIGHTS];
	float lightIntensity0;
	float4 finalColor;
	float4 color;
	float4 ambientColor = float4(0.15, 0.15, 0.15, 1.0);

	float4 colorArray[NUM_LIGHTS];
	float4 colorSum;
	
	float3 reflection;
	float4 specular= float4(0.0, 0.0, 0.0, 0.0);


	textureColor = diffuseTexture.Sample(diffuseSampleType,input.uv);

	colorSum = float4(0.0, 0.0, 0.0, 1.0);

	for(int i = 0; i < NUM_LIGHTS; i++)
	{
		lightIntensity[i] = saturate(dot(input.normal, input.lightPos[i]));

		colorArray[i] = diffuseColor[i] * lightIntensity[i];

		colorSum += colorArray[i];
	}

	colorSum = saturate(colorSum);

	lightDir = normalize(-lightDirection);

	//lightIntensity0 = saturate(dot(input.normal, lightDir));

	//color = diffuseColor * lightIntensity0 + colorSum;
	
	finalColor = saturate(colorSum+ambientColor) * textureColor;

	reflection = normalize(2.0f * lightIntensity[3]  * input.normal - lightDir);
	specular = pow(saturate(dot(reflection, input.viewDirection)), specularPower);

	finalColor = saturate(finalColor + specular * SpecularColor);

	return finalColor;
}